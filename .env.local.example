# Strapi backend origin.
# Local:      http://localhost:1337
# Production: https://cms.friendsofnyinawajambo.org
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here

PORT=3000

# Webhook secret for Strapi revalidation (generate a secure random string)
# Use this same value in Strapi webhook headers as: x-webhook-secret
REVALIDATION_SECRET=your_secure_random_secret_here
